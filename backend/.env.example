# Copy to .env and fill in. Never commit .env.
# Gmail needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.store.account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=your.store.account@gmail.com
APP_URL=http://localhost:4200

# Comma-separated emails that get the admin dashboard (sign up with one of these)
ADMIN_EMAILS=admin@zestora.dev
